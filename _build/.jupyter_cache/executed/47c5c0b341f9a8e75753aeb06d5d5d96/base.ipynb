   "source": [
    "# Python\n",
    "\n",
    "primes = []\n",
    "num = 2\n",
    "\n",
    "while len(primes) < 25:\n",
    "    is_prime = True\n",
    "    for i in range(2, int(num ** 0.5) + 1):\n",
    "        if num % i == 0:\n",
    "            is_prime = False\n",
    "            break\n",
    "    if is_prime:\n",
    "        primes.append(num)\n",
    "    num += 1\n",
    "\n",
    "print(primes)\n"
   ]
